{
  "name": "besta-project",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.lambda.json",
    "prepare": "husky",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "lint": "biome check ."
  },
  "lint-staged": {
    "*.{ts,js,mjs,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.600.0",
    "@aws-sdk/client-ses": "3.600.0",
    "@vendia/serverless-express": "4.10.0",
    "express": "4.19.0",
    "mysql2": "3.22.4",
    "sequelize": "6.37.8",
    "swagger-ui-express": "5.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/aws-lambda": "8.10.0",
    "@types/express": "4.17.0",
    "@types/node": "20.19.41",
    "@types/sequelize": "4.28.20",
    "@types/swagger-ui-express": "4.1.8",
    "aws-cdk": "2.150.0",
    "aws-cdk-lib": "2.150.0",
    "constructs": "10.0.0",
    "esbuild": "0.28.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.6",
    "ts-node": "10.9.0",
    "typescript": "~5.5.0"
  }
}
